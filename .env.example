# ── LLM Configuration ─────────────────────────────────────────────────────
# Default model for all analyst agents (LiteLLM model string)
MODEL=ollama/llama2:7b
TEMPERATURE=0.7
MAX_TOKENS=4096

# Ollama local server URL (used when MODEL starts with "ollama/")
OLLAMA_BASE_URL=http://localhost:11434

# Cloud provider API keys (leave blank if using Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Budget ─────────────────────────────────────────────────────────────────
# Total token budget for the entire debate (across all agents & rounds)
DEFAULT_BUDGET=40000

# Minimum tokens reserved for the synthesis step
MIN_SYNTHESIS_TOKENS=2000

# Minimum tokens per agent per round (guards against starvation)
MIN_AGENT_TOKENS=400

# Maximum debate rounds before forcing synthesis
DEFAULT_MAX_ROUNDS=3

# Minimum budget required to spawn a tiebreaker agent
TIEBREAKER_MIN_BUDGET=3000

# ── Explore-Exploit Thresholds ─────────────────────────────────────────────
# Divergence score > explore_threshold → EXPLORE mode (keep debating)
EXPLORE_THRESHOLD=0.55
# Divergence score < exploit_threshold → EXPLOIT mode (go deeper, converge)
EXPLOIT_THRESHOLD=0.35

# ── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Langfuse (optional — leave blank to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Embeddings (for semantic divergence scoring) ───────────────────────────
# Uses sentence-transformers under the hood. Falls back to keyword overlap
# if sentence-transformers is not installed (less accurate).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Agent Settings ─────────────────────────────────────────────────────────
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=1.0
AGENT_REQUEST_TIMEOUT=120
