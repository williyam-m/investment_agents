# LLM Configuration (default: local Ollama)
DEFAULT_MODEL=ollama/llama2
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Budget defaults
TOTAL_TOKEN_BUDGET=40000
MAX_ROUNDS=3
RESERVED_SYNTHESIS_TOKENS=2000
MIN_SYNTHESIS_TOKENS=1500
TIEBREAKER_MIN_BUDGET=1500

# Agent settings
AGENT_MAX_RETRIES=3
AGENT_REQUEST_TIMEOUT=120

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
